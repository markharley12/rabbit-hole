{
  "name": "rabbit-hole",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run courses && vite",
    "build": "npm run courses && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tools": "env -u PYTHONPATH python3 -m unittest discover -s tools/tests",
    "build:map": "env -u PYTHONPATH python3 tools/build_maths_map.py",
    "courses": "env -u PYTHONPATH python3 tools/validate_courses.py --publish",
    "pack": "env -u PYTHONPATH python3 tools/pack_course.py",
    "validate": "env -u PYTHONPATH python3 tools/validate_courses.py",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:tools && npm run validate"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "katex": "0.19.1",
    "marked": "15.0.12",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.10",
    "vitest": "^5.0.0"
  }
}
